      "get": {
        "summary": "Analytics Quality",
        "description": "Abstention rate (queries with 0 sources \u2014 the RAG pipeline's no-docs\nbranch), reranker-degraded count, feedback score distribution, plus a\ndaily breakdown for the Insights quality-over-time chart.",
        "operationId": "analytics_quality_analytics_quality_get",
        "parameters": [
