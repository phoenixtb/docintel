    "/analytics/feedback": {
      "get": {
        "summary": "Analytics Feedback List",
        "description": "Paginated feedback items for the Feedback Review page \u2014 query + answer\n(+ any sources captured at feedback time) with an ANY LEFT JOIN back to\nquery_events for the Langfuse trace_id (B4 deep-link). Defaults to no\nliked filter; the UI defaults its own view to dislikes-only for triage.",
        "operationId": "analytics_feedback_list_analytics_feedback_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "title": "Page Size"
            }
          },
          {
            "name": "liked",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Liked"
            }
          },
          {
            "name": "tenant_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
