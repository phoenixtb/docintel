  "components": {
    "schemas": {
      "FeedbackEvent": {
        "properties": {
          "query_id": {
            "type": "string",
            "title": "Query Id"
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "default": ""
          },
          "liked": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Liked"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "query_text": {
            "type": "string",
            "title": "Query Text",
            "default": ""
          },
          "answer_text": {
            "type": "string",
            "title": "Answer Text",
            "default": ""
          },
          "sources_json": {
            "type": "string",
            "title": "Sources Json",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "query_id",
          "tenant_id"
        ],
        "title": "FeedbackEvent"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QueryEvent": {
        "properties": {
          "query_id": {
            "type": "string",
            "title": "Query Id"
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "default": ""
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms",
            "default": 0
          },
          "model_used": {
            "type": "string",
            "title": "Model Used",
            "default": ""
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit",
            "default": false
          },
          "source_count": {
            "type": "integer",
            "title": "Source Count",
            "default": 0
          },
          "thinking_truncated": {
            "type": "boolean",
            "title": "Thinking Truncated",
            "default": false
          },
          "prompt_tokens": {
            "type": "integer",
            "title": "Prompt Tokens",
            "default": 0
          },
          "completion_tokens": {
            "type": "integer",
            "title": "Completion Tokens",
            "default": 0
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd",
            "default": 0.0
          },
          "query_text": {
            "type": "string",
            "title": "Query Text",
            "default": ""
          },
          "retrieval_mode": {
            "type": "string",
            "title": "Retrieval Mode",
            "default": ""
          },
          "rerank_candidates_in": {
            "type": "integer",
            "title": "Rerank Candidates In",
            "default": 0
          },
          "rerank_candidates_out": {
            "type": "integer",
            "title": "Rerank Candidates Out",
            "default": 0
          },
          "reranker_degraded": {
            "type": "boolean",
            "title": "Reranker Degraded",
            "default": false
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "query_id",
          "tenant_id"
        ],
        "title": "QueryEvent"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
